<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Set before host creation; changing sources afterwards can already have installed watchers. -->
      <DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE>false</DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
