<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <EnableGameDebugging>false</EnableGameDebugging>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <BundleExtraAssemblies>All</BundleExtraAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameFreeGovernance)' == 'true'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StardewAI.Contracts\StardewAI.Contracts.csproj" />
    <ProjectReference Include="..\..\src\StardewAI.Core\StardewAI.Core.csproj" />
    <ProjectReference Include="..\..\src\StardewAI.TransparentBridge\StardewAI.TransparentBridge.csproj" />
    <ProjectReference Include="..\..\src\StardewAI.RuntimePrimitives\StardewAI.RuntimePrimitives.csproj" />
    <ProjectReference Include="..\..\tools\StardewAI.LiveTrainingLoop\StardewAI.LiveTrainingLoop.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameFreeGovernance)' == 'true'">
    <Compile Include="CandidateRouteConnectorCacheTests.cs" />
    <Compile Include="NativeObjectMechanicsGovernanceTests.cs" />
    <Compile Include="RuntimeEvidenceFreshnessGovernanceTests.cs" />
    <PackageReference Update="Pathoschild.Stardew.ModBuildConfig"
                      ExcludeAssets="compile;runtime;build;buildTransitive;native;contentfiles;analyzers" />
    <ProjectReference Remove="..\..\src\StardewAI.TransparentBridge\StardewAI.TransparentBridge.csproj" />
    <ProjectReference Remove="..\..\src\StardewAI.RuntimePrimitives\StardewAI.RuntimePrimitives.csproj" />
    <ProjectReference Remove="..\..\tools\StardewAI.LiveTrainingLoop\StardewAI.LiveTrainingLoop.csproj" />
  </ItemGroup>

</Project>
