<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StardewAI.DemonstrationRecorder</AssemblyName>
    <RootNamespace>StardewAI.DemonstrationRecorder</RootNamespace>
    <EnableModDeploy>false</EnableModDeploy>
    <GamePath Condition="'$(GamePath)' == ''">E:\StardewValleyAICompanion-runtime\Stardew Valley</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
