{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardewai.local/schemas/command.v1.json",
  "title": "StardewAI Command Preview",
  "type": "object",
  "required": [
    "command_id",
    "feasibility",
    "preview_only",
    "execution_permission",
    "would_be_executable",
    "required_state_factors",
    "missing_state_factors",
    "precondition_results",
    "expected_effects",
    "irreversible_effects",
    "risk_level",
    "recoverability",
    "blocking_reasons"
  ],
  "properties": {
    "command_id": { "type": "string" },
    "goal": { "type": "object" },
    "selected_option": { "type": "object" },
    "option_instance": { "type": "object" },
    "plan": { "type": "object" },
    "feasibility": { "enum": ["feasible", "blocked", "unknown"] },
    "preview_only": { "const": true },
    "execution_permission": { "const": "disabled" },
    "would_be_executable": { "type": "boolean" },
    "required_state_factors": { "type": "array", "items": { "type": "string" } },
    "missing_state_factors": { "type": "array", "items": { "type": "string" } },
    "precondition_results": { "type": "array" },
    "expected_effects": { "type": "array" },
    "irreversible_effects": { "type": "array" },
    "estimated_duration": {},
    "risk_level": { "enum": ["none", "low", "medium", "high", "blocked"] },
    "recoverability": { "enum": ["recoverable", "partial", "irreversible", "unknown"] },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
