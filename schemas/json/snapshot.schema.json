{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardewai.local/schemas/snapshot.v1.json",
  "title": "StardewAI Snapshot Envelope",
  "type": "object",
  "required": ["schema_version", "bridge_version", "game_tick", "real_timestamp", "state_hash", "completeness", "unavailable_fields", "state"],
  "properties": {
    "schema_version": { "const": "snapshot.v1" },
    "bridge_version": { "type": "string" },
    "smapi_version": { "type": "string" },
    "game_version": { "type": "string" },
    "installed_mods": { "type": "array" },
    "save_id": { "$ref": "#/$defs/field" },
    "player_id": { "$ref": "#/$defs/field" },
    "game_tick": { "type": "integer" },
    "in_game_time": { "$ref": "#/$defs/field" },
    "real_timestamp": { "type": "string", "format": "date-time" },
    "state_hash": { "type": "string" },
    "completeness": { "enum": ["complete", "partial"] },
    "unavailable_fields": { "type": "array", "items": { "type": "string" } },
    "state": { "type": "object" }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["value", "status", "source", "adapter", "read_at_tick", "confidence"],
      "properties": {
        "value": {},
        "status": { "enum": ["available", "derived", "unavailable"] },
        "source": {},
        "adapter": { "type": "string" },
        "read_at_tick": { "type": "integer" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
